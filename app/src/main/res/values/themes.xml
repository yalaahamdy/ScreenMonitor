    <!-- Immersive viewer: pure black chrome in BOTH modes.
         Defined once here (values/) — night config falls back to it.
         Literal light-on-dark tokens keep text/icons readable on black
         even when the app is in light mode. -->
    <style name="Theme.ScreenGuard.Viewer">
        <item name="sgTextPrimary">#F5F2EA</item>
        <item name="sgTextSecondary">#ADB9D3</item>
        <item name="sgTextTertiary">#8794B4</item>
        <item name="sgAccent">#D4B46A</item>
        <item name="sgAccentText">#D4B46A</item>
        <item name="sgRipple">#26D4B46A</item>
        <item name="colorPrimary">#D4B46A</item>
        <item name="colorOnPrimary">#211907</item>
        <item name="colorSurface">#000000</item>
        <item name="colorOnSurface">#F5F2EA</item>
        <item name="colorOnSurfaceVariant">#ADB9D3</item>
        <item name="android:statusBarColor">@color/viewer_bg</item>
        <item name="android:navigationBarColor">@color/viewer_bg</item>
        <item name="android:windowBackground">@color/viewer_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- ============================================================
         Block fallback activity — PINNED DARK in both modes so the
         lock screen keeps its authority day and night (matches the
         WindowManager overlay, which is always dark). All tokens are
         literal hex so day/night color swapping cannot leak in.
         ============================================================ -->
    <style name="Theme.ScreenGuard.BlockDialog">
        <item name="sgCanvas">#0A0E18</item>
        <item name="sgHeader">#0D1424</item>
        <item name="sgSurface">#121A2C</item>
        <item name="sgSurfaceElev">#18233B</item>
        <item name="sgSurfaceAlt">#0F1626</item>
        <item name="sgOutline">#2B3A5E</item>
        <item name="sgOutlineStrong">#435684</item>
        <item name="sgDivider">#273356</item>
        <item name="sgAccent">#D4B46A</item>
        <item name="sgAccentSoft">#E9D8AC</item>
        <item name="sgAccentDeep">#8F7440</item>
        <item name="sgOnAccent">#211907</item>
        <item name="sgAccentContainer">#2A2312</item>
        <item name="sgAccentHairline">#808F7440</item>
        <item name="sgAccentText">#D4B46A</item>
        <item name="sgRipple">#26D4B46A</item>
        <item name="sgTextPrimary">#F5F2EA</item>
        <item name="sgTextSecondary">#ADB9D3</item>
        <item name="sgTextTertiary">#8794B4</item>
        <item name="sgKeyBg">#151D31</item>
        <item name="colorPrimary">#D4B46A</item>
        <item name="colorOnPrimary">#211907</item>
        <item name="colorSurface">#121A2C</item>
        <item name="colorOnSurface">#F5F2EA</item>
        <item name="colorOnSurfaceVariant">#ADB9D3</item>
        <item name="android:colorBackground">#0A0E18</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Dialogs: themed surface, accent controls -->
    <style name="ScreenGuard.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">?attr/sgAccentText</item>
        <item name="colorSurface">?attr/sgSurface</item>
        <item name="colorOnSurface">?attr/sgTextPrimary</item>
        <item name="colorOnSurfaceVariant">?attr/sgTextSecondary</item>
        <item name="alertDialogStyle">@style/ScreenGuard.Dialog.Style</item>
    </style>

    <style name="ScreenGuard.Dialog.Style" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearanceOverlay">@style/ScreenGuard.Dialog.Shape</item>
        <item name="android:background">?attr/sgSurface</item>
    </style>

    <style name="ScreenGuard.Dialog.Shape" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ScreenGuard.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@null</item>
        <item name="thumbTint">@null</item>
    </style>

