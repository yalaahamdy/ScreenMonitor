    <!-- Immersive viewer: pure black chrome regardless of palette -->
    <style name="Theme.ScreenGuard.Viewer">
        <item name="android:statusBarColor">@color/viewer_bg</item>
        <item name="android:navigationBarColor">@color/viewer_bg</item>
        <item name="android:windowBackground">@color/viewer_bg</item>
    </style>

    <!-- Dialogs: themed surface, accent controls -->
    <style name="ScreenGuard.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">?attr/sgAccent</item>
        <item name="colorSurface">?attr/sgSurface</item>
        <item name="colorOnSurface">?attr/sgTextPrimary</item>
        <item name="colorOnSurfaceVariant">?attr/sgTextSecondary</item>
        <item name="alertDialogStyle">@style/ScreenGuard.Dialog.Style</item>
    </style>

    <style name="ScreenGuard.Dialog.Style" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearanceOverlay">@style/ScreenGuard.Dialog.Shape</item>
        <item name="android:background">?attr/sgSurface</item>
    </style>

    <style name="ScreenGuard.Dialog.Shape" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ScreenGuard.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@null</item>
        <item name="thumbTint">@null</item>
    </style>

    <!-- ===================== Shared text styles ===================== -->

    <!-- Uppercase accent section labels -->
    <style name="SectionHeader">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">?attr/sgAccent</item>
    </style>

    <style name="RowTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/sgTextPrimary</item>
    </style>

    <style name="RowSubtitle">
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">?attr/sgTextSecondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Serif display numeral -->
    <style name="DisplayNumber">
        <item name="android:textSize">40sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">?attr/sgAccentSoft</item>
    </style>

    <!-- Serif screen titles -->
    <style name="SerifTitle">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">?attr/sgTextPrimary</item>
    </style>

    <!-- ===================== Buttons ===================== -->

    <!-- Accent filled primary action -->
    <style name="AppButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/sgAccent</item>
        <item name="android:textColor">?attr/sgOnAccent</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="rippleColor">#33211907</item>
    </style>

    <!-- Elevated tonal action with accent hairline -->
    <style name="AppTonalButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">?attr/sgSurfaceElev</item>
        <item name="android:textColor">?attr/sgAccentSoft</item>
        <item name="strokeColor">?attr/sgAccentHairline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Keypad digit: dark coin with hairline -->
    <style name="KeypadDigit" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/sgKeyBg</item>
        <item name="android:textColor">?attr/sgTextPrimary</item>
        <item name="android:textSize">23sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="cornerRadius">40dp</item>
        <item name="strokeColor">?attr/sgOutlineStrong</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">#26D4B46A</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
    </style>

    <style name="KeypadIcon" parent="Widget.Material3.Button.IconButton">
        <item name="backgroundTint">?attr/sgKeyBg</item>
        <item name="iconTint">?attr/sgTextSecondary</item>
        <item name="strokeColor">?attr/sgOutlineStrong</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">40dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
    </style>
</resources>
