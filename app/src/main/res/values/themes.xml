        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">?attr/sgAccentText</item>
    </style>

    <style name="RowTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/sgTextPrimary</item>
    </style>

    <style name="RowSubtitle">
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">?attr/sgTextSecondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Serif display numeral -->
    <style name="DisplayNumber">
        <item name="android:textSize">40sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">?attr/sgAccentSoft</item>
    </style>

    <!-- Serif screen titles -->
    <style name="SerifTitle">
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">?attr/sgTextPrimary</item>
    </style>

    <!-- ===================== Buttons ===================== -->

    <!-- Accent filled primary action -->
    <style name="AppButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/sgAccent</item>
        <item name="android:textColor">?attr/sgOnAccent</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="rippleColor">?attr/sgRipple</item>
    </style>

    <!-- Elevated tonal action with accent hairline -->
    <style name="AppTonalButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">?attr/sgSurfaceElev</item>
        <item name="android:textColor">?attr/sgAccentText</item>
        <item name="strokeColor">?attr/sgAccentHairline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="rippleColor">?attr/sgRipple</item>
    </style>

    <!-- Keypad digit: coin key with hairline -->
    <style name="KeypadDigit" parent="Widget.Material3.Button">
        <item name="android:layout_width">76dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_margin">7dp</item>
        <item name="backgroundTint">?attr/sgKeyBg</item>
        <item name="android:textColor">?attr/sgTextPrimary</item>
        <item name="android:textSize">23sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="cornerRadius">40dp</item>
        <item name="strokeColor">?attr/sgOutlineStrong</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">?attr/sgRipple</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
    </style>

    <style name="KeypadIcon" parent="Widget.Material3.Button.IconButton">
        <item name="android:layout_width">76dp</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:layout_margin">7dp</item>
        <item name="backgroundTint">?attr/sgKeyBg</item>
        <item name="iconTint">?attr/sgTextSecondary</item>
        <item name="strokeColor">?attr/sgOutlineStrong</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">40dp</item>
        <item name="android:insetTop">4dp</item>
        <item name="android:insetBottom">4dp</item>
    </style>
    <style name="BypassKeyRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">horizontal</item>
    </style>
    <style name="SGNavItemIndicator">
        <item name="android:color">?attr/sgAccentContainer</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <style name="SGPeriodChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textColor">?attr/sgTextSecondary</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:layout_marginEnd">6dp</item>
    </style>

    <style name="SGInput">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">?attr/sgTextPrimary</item>
        <item name="android:textColorHint">?attr/sgTextTertiary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
