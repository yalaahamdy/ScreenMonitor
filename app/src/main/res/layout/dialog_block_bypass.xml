<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView root: the two-step bypass dialog is taller than many small
     phones (and any phone in landscape); without scrolling its buttons get
     clipped. The ScrollView lets the full dialog stay reachable. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_block_card"
        android:orientation="vertical"
        android:padding="22dp">

    <!-- Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/bypassIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@string/overlay_bypass_button"
            android:src="@drawable/ic_clock"
            app:tint="@color/overlay_warning" />

        <TextView
            android:id="@+id/bypassTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/overlay_bypass_button"
            android:textColor="?attr/sgTextPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ============ STEP 1: duration selection ============ -->
    <LinearLayout
        android:id="@+id/durationStep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bypassDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="?attr/sgTextSecondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/durationBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill_outline"
            android:paddingStart="16dp"
            android:paddingTop="7dp"
            android:paddingEnd="16dp"
            android:paddingBottom="7dp"
            android:textColor="@color/overlay_warning"
            android:textSize="14sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/durationSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:max="299"
            android:progress="14" />

        <!-- Fine-tune buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMinus15"
                style="@style/AppTonalButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="@string/dur_short_minus_15m" />

            <Button
                android:id="@+id/btnMinus1"
                style="@style/AppTonalButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="@string/dur_short_minus_1m" />

            <Button
                android:id="@+id/btnPlus1"
                style="@style/AppTonalButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="@string/dur_short_plus_1m" />

            <Button
                android:id="@+id/btnPlus15"
                style="@style/AppTonalButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="@string/dur_short_plus_15m" />
        </LinearLayout>

        <!-- Preset chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/preset1"
                style="@style/AppTonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="@string/dur_short_1m" />

            <Button
                android:id="@+id/preset5"
                style="@style/AppTonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="@string/dur_short_5m" />

            <Button
                android:id="@+id/preset15"
                style="@style/AppTonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="@string/dur_short_15m" />

            <Button
                android:id="@+id/preset30"
                style="@style/AppTonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="@string/dur_short_30m" />

            <Button
                android:id="@+id/preset60"
                style="@style/AppTonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="@string/dur_short_1h" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/preset120"
                style="@style/AppTonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="@string/dur_short_2h" />

            <Button
                android:id="@+id/preset180"
                style="@style/AppTonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="@string/dur_short_3h" />

            <Button
                android:id="@+id/preset300"
                style="@style/AppTonalButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:padding="0dp"
                android:textSize="12sp"
                android:text="@string/dur_short_5h" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="2" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/overlay_bypass_security_note"
            android:textColor="?attr/sgTextTertiary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancel"
                style="@style/AppTonalButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/action_cancel" />

            <Button
                android:id="@+id/btnProceed"
                style="@style/AppButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1.4"
                android:text="@string/overlay_continue_to_pin" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ STEP 2: PIN verification ============ -->
    <LinearLayout
        android:id="@+id/pinStep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/pinSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="?attr/sgTextSecondary"
            android:textSize="13sp" />

        <com.screenguard.app.PinDotsView
            android:id="@+id/pinDots"
            android:layout_width="170dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/pinError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="@color/overlay_danger"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 3x4 keypad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <LinearLayout style="@style/BypassKeyRow">
                <Button android:id="@+id/key1" style="@style/KeypadDigit" android:layout_width="0dp" android:layout_weight="1" android:text="1" />
                <Button android:id="@+id/key2" style="@style/KeypadDigit" android:layout_width="0dp" android:layout_weight="1" android:text="2" />
                <Button android:id="@+id/key3" style="@style/KeypadDigit" android:layout_width="0dp" android:layout_weight="1" android:text="3" />
            </LinearLayout>

            <LinearLayout style="@style/BypassKeyRow">
                <Button android:id="@+id/key4" style="@style/KeypadDigit" android:layout_width="0dp" android:layout_weight="1" android:text="4" />
                <Button android:id="@+id/key5" style="@style/KeypadDigit" android:layout_width="0dp" android:layout_weight="1" android:text="5" />
                <Button android:id="@+id/key6" style="@style/KeypadDigit" android:layout_width="0dp" android:layout_weight="1" android:text="6" />
            </LinearLayout>

            <LinearLayout style="@style/BypassKeyRow">
                <Button android:id="@+id/key7" style="@style/KeypadDigit" android:layout_width="0dp" android:layout_weight="1" android:text="7" />
                <Button android:id="@+id/key8" style="@style/KeypadDigit" android:layout_width="0dp" android:layout_weight="1" android:text="8" />
                <Button android:id="@+id/key9" style="@style/KeypadDigit" android:layout_width="0dp" android:layout_weight="1" android:text="9" />
            </LinearLayout>

            <LinearLayout style="@style/BypassKeyRow">
                <Button
                    android:id="@+id/keyClearDummy"
                    style="@style/KeypadDigit"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:visibility="invisible"
                    android:text="0" />
                <Button android:id="@+id/key0" style="@style/KeypadDigit" android:layout_width="0dp" android:layout_weight="1" android:text="0" />
                <ImageButton
                    android:id="@+id/keyBackspace"
                    style="@style/KeypadIcon"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_backspace"
                    android:contentDescription="@string/keypad_delete" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBackToDuration"
                style="@style/AppTonalButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/overlay_edit_duration" />

            <Button
                android:id="@+id/btnPinCancel"
                style="@style/AppTonalButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/action_cancel" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>
</ScrollView>
