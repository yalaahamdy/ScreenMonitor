        <item name="colorSurfaceBright">@color/surface_elev</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/divider</item>
        <item name="colorError">@color/danger</item>
        <item name="colorOnError">@color/error_on</item>
        <item name="colorErrorContainer">@color/danger_container</item>
        <item name="colorOnErrorContainer">@color/danger</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/bg</item>

        <item name="android:colorControlActivated">@color/gold</item>
