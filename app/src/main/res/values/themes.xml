<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         ScreenGuard — five luxury dark themes.
         Theme.ScreenGuard (base) = Midnight Prestige.
         Each variant re-maps the sg_* tokens AND the Material 3
         color roles, so widgets and custom drawables follow theme.
         ============================================================ -->

    <style name="Theme.ScreenGuard" parent="Theme.Material3.Dark.NoActionBar">
        <!-- sg tokens: Midnight Prestige -->
        <item name="sgCanvas">@color/bg</item>
        <item name="sgHeader">@color/header</item>
        <item name="sgSurface">@color/surface</item>
        <item name="sgSurfaceElev">@color/surface_elev</item>
        <item name="sgSurfaceAlt">@color/surface_alt</item>
        <item name="sgOutline">@color/outline</item>
        <item name="sgOutlineStrong">@color/outline_strong</item>
        <item name="sgDivider">@color/divider</item>
        <item name="sgAccent">@color/gold</item>
        <item name="sgAccentSoft">@color/gold_soft</item>
        <item name="sgAccentDeep">@color/gold_deep</item>
        <item name="sgOnAccent">@color/on_gold</item>
        <item name="sgAccentContainer">@color/gold_container</item>
        <item name="sgAccentHairline">@color/gold_hairline</item>
        <item name="sgTextPrimary">@color/text_primary</item>
        <item name="sgTextSecondary">@color/text_secondary</item>
        <item name="sgTextTertiary">@color/text_tertiary</item>
        <item name="sgKeyBg">@color/key_bg</item>

        <!-- Material 3 color roles -->
        <item name="colorPrimary">@color/gold</item>
        <item name="colorOnPrimary">@color/on_gold</item>
        <item name="colorPrimaryContainer">@color/gold_container</item>
        <item name="colorOnPrimaryContainer">@color/gold_soft</item>
        <item name="colorSecondary">@color/gold_soft</item>
        <item name="colorOnSecondary">@color/on_gold</item>
        <item name="colorSecondaryContainer">@color/gold_container</item>
        <item name="colorOnSecondaryContainer">@color/gold_soft</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorOnBackground">@color/text_primary</item>

        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/bg</item>

        <item name="android:colorControlActivated">@color/gold</item>
        <item name="android:colorControlNormal">@color/text_tertiary</item>
        <item name="android:colorControlHighlight">#26D4B46A</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <item name="materialAlertDialogTheme">@style/ScreenGuard.Dialog</item>
        <item name="switchStyle">@style/ScreenGuard.Switch</item>
    </style>

