<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         ScreenGuard — DARK theme definitions (values-night).
         The five luxury palettes, v3.2.0 contrast-tuned:
           * tertiary/secondary text lifted to WCAG-safe levels
           * outlines/dividers perceptibly stronger
           * full Material 3 color-role mapping (containers, inverse,
             surface container tones) so every widget follows theme
           * new tokens: sgAccentText (accent safe for text),
             sgRipple (accent-tinted ripple)
         The light counterparts live in values/themes.xml.
         ============================================================ -->

    <style name="Theme.ScreenGuard" parent="Theme.Material3.Dark.NoActionBar">
        <!-- sg tokens: Midnight Prestige -->
        <item name="sgCanvas">@color/bg</item>
        <item name="sgHeader">@color/header</item>
        <item name="sgSurface">@color/surface</item>
        <item name="sgSurfaceElev">@color/surface_elev</item>
        <item name="sgSurfaceAlt">@color/surface_alt</item>
        <item name="sgOutline">@color/outline</item>
        <item name="sgOutlineStrong">@color/outline_strong</item>
        <item name="sgDivider">@color/divider</item>
        <item name="sgAccent">@color/gold</item>
        <item name="sgAccentSoft">@color/gold_soft</item>
        <item name="sgAccentDeep">@color/gold_deep</item>
        <item name="sgOnAccent">@color/on_gold</item>
        <item name="sgAccentContainer">@color/gold_container</item>
        <item name="sgAccentHairline">@color/gold_hairline</item>
        <item name="sgAccentText">@color/gold</item>
        <item name="sgRipple">#26D4B46A</item>
        <item name="sgTextPrimary">@color/text_primary</item>
        <item name="sgTextSecondary">@color/text_secondary</item>
        <item name="sgTextTertiary">@color/text_tertiary</item>
        <item name="sgKeyBg">@color/key_bg</item>

        <!-- Material 3 color roles -->
        <item name="colorPrimary">@color/gold</item>
        <item name="colorOnPrimary">@color/on_gold</item>
        <item name="colorPrimaryContainer">@color/gold_container</item>
        <item name="colorOnPrimaryContainer">@color/gold_soft</item>
