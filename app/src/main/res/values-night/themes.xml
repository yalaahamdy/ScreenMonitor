        <item name="colorOnSecondary">@color/on_gold</item>
        <item name="colorSecondaryContainer">@color/gold_container</item>
        <item name="colorOnSecondaryContainer">@color/gold_soft</item>
        <item name="colorTertiary">@color/gold</item>
        <item name="colorOnTertiary">@color/on_gold</item>
        <item name="colorTertiaryContainer">@color/gold_container</item>
        <item name="colorOnTertiaryContainer">@color/gold_soft</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceVariant">@color/surface_alt</item>
        <item name="colorSurfaceContainerLowest">@color/surface_alt</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_elev</item>
        <item name="colorSurfaceContainerHighest">@color/surface_elev</item>
